rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userRef() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function activeUser() {
      return signedIn()
        && exists(userRef())
        && get(userRef()).data.active == true;
    }

    function admin() {
      return activeUser() && get(userRef()).data.role == 'admin';
    }

    function ownsAccessRequest(uid) {
      return signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email;
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || admin());
      allow list: if admin();
      allow create, update, delete: if admin();

      match /settings/{settingId} {
        allow read, create, update: if signedIn() && request.auth.uid == uid;
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      match /tasks/{taskId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.updatedBy == request.auth.uid;
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }

    match /accessRequests/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || admin());
      allow list: if admin();

      allow create: if ownsAccessRequest(uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'photoURL', 'requestedAt'
        ]);

      allow update: if ownsAccessRequest(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'requestedAt'
        ]);

      allow delete: if admin();
    }

    match /schools/{schoolId} {
      allow read: if activeUser();
      allow create, delete: if admin();
      allow update: if admin() || (
        activeUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'expectedShifts',
          'expectedShiftsUpdatedAt',
          'expectedShiftsUpdatedBy',
          'expectedShiftRoster',
          'expectedShiftRosterVersion',
          'expectedShiftRosterUpdatedAt',
          'expectedShiftRosterUpdatedBy'
        ])
        && request.resource.data.expectedShifts is list
        && request.resource.data.expectedShifts.size() <= 4
        && request.resource.data.expectedShiftsUpdatedBy == request.auth.uid
        && request.resource.data.expectedShiftRoster is map
        && request.resource.data.expectedShiftRoster.keys().hasOnly([
          'manha', 'integral', 'tarde', 'noite'
        ])
        && (!(request.resource.data.expectedShiftRoster.keys().hasAny(['manha'])) || request.resource.data.expectedShiftRoster.manha is bool)
        && (!(request.resource.data.expectedShiftRoster.keys().hasAny(['integral'])) || request.resource.data.expectedShiftRoster.integral is bool)
        && (!(request.resource.data.expectedShiftRoster.keys().hasAny(['tarde'])) || request.resource.data.expectedShiftRoster.tarde is bool)
        && (!(request.resource.data.expectedShiftRoster.keys().hasAny(['noite'])) || request.resource.data.expectedShiftRoster.noite is bool)
        && request.resource.data.expectedShiftRosterVersion == 2
        && request.resource.data.expectedShiftRosterUpdatedBy == request.auth.uid
      );
    }

    match /months/{monthId} {
      allow read: if activeUser();
      allow create, update: if activeUser()
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if admin();

      match /schools/{schoolId} {
        allow read: if activeUser();

        allow create: if activeUser()
          && exists(/databases/$(database)/documents/schools/$(schoolId))
          && request.resource.data.schoolId == schoolId
          && request.resource.data.month == monthId
          && request.resource.data.updatedBy == request.auth.uid;

        allow update: if activeUser()
          && resource.data.schoolId == schoolId
          && resource.data.month == monthId
          && request.resource.data.schoolId == schoolId
          && request.resource.data.month == monthId
          && request.resource.data.updatedBy == request.auth.uid;

        allow delete: if admin();
      }
    }



    match /schoolProfiles/{schoolId} {
      allow read: if activeUser();
      allow create, update: if activeUser()
        && exists(/databases/$(database)/documents/schools/$(schoolId))
        && request.resource.data.schoolId == schoolId
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if admin();
    }

    match /schoolSecrets/{schoolId} {
      allow read: if activeUser();
      allow create, update: if activeUser()
        && exists(/databases/$(database)/documents/schools/$(schoolId))
        && request.resource.data.schoolId == schoolId
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if admin();
    }

    match /vault/{docId} {
      allow read: if activeUser();
      allow create, update, delete: if admin();
    }

    match /assistantEvents/{eventId} {
      allow read: if activeUser();
      allow create, update, delete: if admin();
    }

    match /dailyRuns/{runId} {
      allow read: if activeUser();
      allow create, update: if activeUser()
        && request.resource.data.importedBy == request.auth.uid;
      allow delete: if admin();
    }

    match /imports/{importId} {
      allow read: if activeUser();
      allow create: if activeUser()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if admin();
    }

    match /auditLogs/{logId} {
      allow read: if activeUser();
      allow create: if activeUser()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
